# Copy to .env on the server and fill in. Never commit .env.

# Public domain pointing at the server, e.g. a DuckDNS subdomain
PULSE_DOMAIN=pulse-example.duckdns.org

# Database password; generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# Telegram bot (optional): token from @BotFather, then your chat id from the bot itself
PULSE_TELEGRAM_ENABLED=false
PULSE_TELEGRAM_TOKEN=
PULSE_TELEGRAM_OWNER_CHAT_ID=
# open to everyone, the public channel (@name; the bot must be its admin) and the bot's name for
# the buttons on the site (empty: asked from Telegram). The buttons show only when the bot is on.
PULSE_TELEGRAM_OPEN=false
PULSE_TELEGRAM_CHANNEL=
PULSE_TELEGRAM_BOT_USERNAME=
# what channel posts link to, tagged utm_source=telegram (default: the permanent link on GitHub
# Pages, which follows the site wherever it runs); empty: no link
PULSE_SITE_URL=https://addictcode.github.io/pulse-crypto-screener/

# Uptime alarm (optional): the ping URL of a free check on healthchecks.io, period 1 minute.
# The server pings it every minute while the site answers; the check alerts you once pings stop.
PULSE_HEARTBEAT_URL=

# Capacity (optional). The Mac defaults hold ~300 viewers of the terminal; on an Oracle A1 with
# 12 GB raise them together, e.g. 3g and 800 (loadtest/REPORT.md). The landing does not count:
# it polls a cached summary instead of holding a stream.
PULSE_BACKEND_MEMORY=1536m
PULSE_STREAM_CLIENTS=300
PULSE_STREAM_CLIENTS_PER_ADDRESS=30
# errors from visitors' browsers, counted for a day and summed up to the owner daily (README)
PULSE_CLIENT_ERRORS_ENABLED=true

# Web push without Telegram (optional): a key pair from `node deploy/vapid-keys.mjs`, and a contact
# push services may write to. Without the keys the site does not offer notifications.
PULSE_VAPID_PUBLIC_KEY=
PULSE_VAPID_PRIVATE_KEY=
PULSE_VAPID_SUBJECT=mailto:you@example.com
