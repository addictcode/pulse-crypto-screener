# Plain HTTP on :8088, a throwaway database password. Not for a real server.
PULSE_DOMAIN=localhost
PULSE_SITE_ADDRESS=:80
PULSE_PUBLIC_ORIGIN=http://localhost:8088
PULSE_HTTP_PORT=8088
PULSE_HTTPS_PORT=8443
POSTGRES_PASSWORD=loadtest-only
# its own image names: the defaults are the live stack's, which a test build must not replace
PULSE_BACKEND_IMAGE=pulse-load-backend
PULSE_WEB_IMAGE=pulse-load-web
