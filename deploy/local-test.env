# Runs the production stack on this machine over plain HTTP, for checking images before a deploy:
#   docker compose -p pulse-local -f compose.prod.yaml --env-file deploy/local-test.env up -d --build
PULSE_DOMAIN=localhost
PULSE_SITE_ADDRESS=:80
PULSE_PUBLIC_ORIGIN=http://localhost:8088
PULSE_HTTP_PORT=8088
PULSE_HTTPS_PORT=8443
POSTGRES_PASSWORD=local-test-only
