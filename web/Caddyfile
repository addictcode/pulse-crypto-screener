# One origin for everything: the app, its API and the market stream.
# PULSE_SITE_ADDRESS is the domain in production (Caddy gets a Let's Encrypt certificate
# for it automatically) or ":80" for a plain-HTTP local run.
{$PULSE_SITE_ADDRESS} {
	encode zstd gzip

	@backend path /api/* /ws/*
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# everything else (index.html and SPA routes) must be revalidated, or deploys would not show up
		header ?Cache-Control "no-cache"
		# /app/ is the terminal, anything else unknown falls back to the landing page
		try_files {path} {path}/index.html /index.html
		file_server
	}

	# the redirect page on GitHub Pages asks this from another origin to learn whether the
	# full version is up; without the header it cannot tell Pulse from a tunnel error page
	header /api/status Access-Control-Allow-Origin "*"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
