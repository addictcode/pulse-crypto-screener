# Copy to .env on the server and fill in. Never commit .env.

# Public domain pointing at the server, e.g. a DuckDNS subdomain
PULSE_DOMAIN=pulse-example.duckdns.org

# Database password; generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# Telegram bot (optional): token from @BotFather, then your chat id from the bot itself
PULSE_TELEGRAM_ENABLED=false
PULSE_TELEGRAM_TOKEN=
PULSE_TELEGRAM_OWNER_CHAT_ID=
