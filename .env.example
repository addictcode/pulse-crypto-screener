# Copy to .env on the server and fill in. Never commit .env.

# Public domain pointing at the server, e.g. a DuckDNS subdomain
PULSE_DOMAIN=pulse-example.duckdns.org

# Database password; generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# Telegram bot (optional): token from @BotFather, then your chat id from the bot itself
PULSE_TELEGRAM_ENABLED=false
PULSE_TELEGRAM_TOKEN=
PULSE_TELEGRAM_OWNER_CHAT_ID=
# open to everyone, the public channel (@name; the bot must be its admin) and the bot's name for
# the buttons on the site (empty: asked from Telegram). The buttons show only when the bot is on.
PULSE_TELEGRAM_OPEN=false
PULSE_TELEGRAM_CHANNEL=
PULSE_TELEGRAM_BOT_USERNAME=

# Uptime alarm (optional): the ping URL of a free check on healthchecks.io, period 1 minute.
# The server pings it every minute while the site answers; the check alerts you once pings stop.
PULSE_HEARTBEAT_URL=
